# ClubPulse Server Environment Configuration Template
# Never commit real credentials or secrets to version control.

# Server Port (Google Cloud Run injects PORT automatically; defaults to 3000)
PORT=3000
NODE_ENV=production

# Cloud SQL for PostgreSQL (Object Method via Cloud SQL Auth Proxy)
SQL_HOST=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
SQL_DB_NAME=clubpulse
SQL_USER=clubpulse_app
SQL_PASSWORD=

# Cloud SQL Admin Credentials (used strictly by drizzle-kit migrations)
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=

# Gemini API (Server-side only — never expose to browser)
GEMINI_API_KEY=

# Optional Institutional Administrator Email (auto-assigned ADMIN role on sign-in)
ADMIN_EMAIL=

# Optional Google Cloud Storage Bucket (Private bucket — never make public)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=

# Optional Google Analytics 4 (Non-PII application usage events only)
VITE_GA4_MEASUREMENT_ID=
